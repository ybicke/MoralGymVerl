# Generated datasets (regenerate via moralgym_verl.training.dataset)
/datasets/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Local logs from setup/download runs
*.log

# Evaluation output: track only per-cell metrics (behavioral.json, probe_*.json) and analysis/
# (write-ups, figures, tables, number macros). Raw rollouts (*.jsonl) and job
# bookkeeping stay out of git; the full tree is in HF dataset moralgym/cluster-archive.
eval_results/**
!eval_results/**/
!eval_results/**/analysis/**
!eval_results/**/behavioral.json
!eval_results/**/probe_*.json
!eval_results/**/summary.txt
eval_results/_archive/
eval_results/**/*.jsonl
eval_results/**/Untitled

# Editor config (interpreter pin + debug launch configs, machine-specific)
.vscode/


# Local assistant instructions, not shared
CLAUDE.md

# Private working material, deliberately not published: design notes and
# results write-ups (docs/), one-off debug harnesses, and the publish
# tooling itself. make_report.sh stays tracked (it is edited often) and is
# dropped from the public tree by scripts/publish/make_public.sh.
docs/
scripts/debug/
scripts/publish/

# Private cluster settings (template: scripts/slurm/cluster.env.example)
scripts/slurm/cluster.env

# pilot run outputs and session handoffs: archived to HF (moralgym/cluster-archive), not tracked
pilots/*/results/
pilots/*/handoffs/
