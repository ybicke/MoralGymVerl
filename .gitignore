# Generated datasets (regenerate via moralgym_verl.training.dataset)
/datasets/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Local logs from setup/download runs
*.log

# Eval result data stays out of git (mirrored to $STORE); track only the
# canonical/superseded record (MANIFEST.md) and the readable analysis:
# results_<model>.md (generated by scripts/analysis/publication_tables.py)
# and analysis_<model>.md (the hand-annotated copy). Cell JSON and tex/ stay out.
eval_results/**
!eval_results/**/
!eval_results/**/MANIFEST.md
!eval_results/**/README.md
!eval_results/**/results_*.md
!eval_results/**/analysis_*.md

# Editor config (interpreter pin + debug launch configs, machine-specific)
.vscode/


# Local assistant instructions, not shared
CLAUDE.md
