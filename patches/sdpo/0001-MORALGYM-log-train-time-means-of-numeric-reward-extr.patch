From 900683b093fd33917de43c0253dfb7abc3f7ae10 Mon Sep 17 00:00:00 2001
From: Yves Bicker <yves_bicker@icloud.com>
Date: Mon, 6 Jul 2026 11:51:07 +0200
Subject: [PATCH 1/4] [MORALGYM] log train-time means of numeric reward extras

verl logs the extra values a reward function returns (here cooperation
rate, parse failures) only during validation. This also logs their
batch means at every training step, so they can be followed during
training.
---
 verl/trainer/ppo/ray_trainer.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/verl/trainer/ppo/ray_trainer.py b/verl/trainer/ppo/ray_trainer.py
index a7256fd..4facafe 100644
--- a/verl/trainer/ppo/ray_trainer.py
+++ b/verl/trainer/ppo/ray_trainer.py
@@ -1792,6 +1792,13 @@ class RayPPOTrainer:
 
                         if reward_extra_infos_dict:
                             batch.non_tensor_batch.update({k: np.array(v) for k, v in reward_extra_infos_dict.items()})
+                            # [MORALGYM] Log train-time batch means of numeric reward
+                            # extras (game behavior rates from compute_score) — stock
+                            # verl only surfaces these during validation.
+                            for k, v in reward_extra_infos_dict.items():
+                                arr = np.asarray(v)
+                                if arr.size and np.issubdtype(arr.dtype, np.number):
+                                    metrics[f"game/{k}"] = float(arr.mean())
 
                         # compute rewards. apply_kl_penalty if available
                         if self.config.algorithm.use_kl_in_reward:
-- 
