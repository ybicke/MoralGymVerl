 verl/trainer/ppo/core_algos.py       |  3 +++
 verl/trainer/ppo/ray_trainer.py      | 31 ++++++++++++++++++++++++++++
 verl/workers/actor/dp_actor.py       |  3 +++
 verl/workers/config/actor.py         |  2 ++
 5 files changed, 43 insertions(+)

