diff --git a/verl/trainer/ppo/ray_trainer.py b/verl/trainer/ppo/ray_trainer.py
index 4facafe..7ead734 100644
--- a/verl/trainer/ppo/ray_trainer.py
+++ b/verl/trainer/ppo/ray_trainer.py
@@ -281,6 +281,27 @@ def compute_advantage(
     return data
 
 
+def _mask_after_marker(responses: torch.Tensor, response_mask: torch.Tensor, tokenizer, marker: str) -> torch.Tensor:
+    """(bs, L) float mask of the response tokens after the last `marker`, all-zero where absent.
+
+    Matched on the concatenated token pieces, so a marker that spans several tokens or merges
+    with a neighbour (Olmo-3: `</`, `think`, `>\\n`) is found like a single-token one (Qwen3).
+    """
+    out = torch.zeros_like(response_mask, dtype=torch.float32)
+    for i, ids in enumerate(responses.tolist()):
+        n = int(response_mask[i].sum().item())
+        text, ends = "", []
+        for piece in tokenizer.convert_ids_to_tokens(ids[:n]):
+            text += piece
+            ends.append(len(text))
+        k = text.rfind(marker)
+        if k < 0:
+            continue
+        last = next(j for j, e in enumerate(ends) if e >= k + len(marker))
+        out[i, last + 1 : n] = 1.0
+    return out * response_mask
+
+
 class RayPPOTrainer:
     """Distributed PPO trainer using Ray for scalable reinforcement learning.
 
@@ -777,6 +798,11 @@ class RayPPOTrainer:
             device=device
         )
 
+        tensors = {}
+        distill_after = self_distillation_cfg.get("distill_after", None)
+        if distill_after:
+            tensors["distill_token_mask"] = _mask_after_marker(responses, response_mask, self.tokenizer, distill_after)
+
         uids = set(batch.non_tensor_batch["uid"])
         num_with_feedback_available = sum(1 for f in feedback_list if f is not None)
         num_with_feedback_used = sum(1 for f in feedback_used if f)
@@ -788,11 +814,16 @@ class RayPPOTrainer:
             "self_distillation/feedback_used_fraction": num_with_feedback_used / batch_size,
             "self_distillation/reprompt_sample_fraction": self_distillation_mask.float().mean().item(),
         }
+        if "distill_token_mask" in tensors:
+            m = tensors["distill_token_mask"]
+            metrics["self_distillation/distill_token_fraction"] = (m.sum() / response_mask.sum().clamp(min=1)).item()
+            metrics["self_distillation/marker_found_fraction"] = (m.sum(-1) > 0).float().mean().item()
         return DataProto.from_dict(tensors={
             "teacher_input_ids": teacher_input_ids,
             "teacher_attention_mask": teacher_attention_mask,
             "teacher_position_ids": teacher_position_ids,
             "self_distillation_mask": self_distillation_mask,
+            **tensors,
