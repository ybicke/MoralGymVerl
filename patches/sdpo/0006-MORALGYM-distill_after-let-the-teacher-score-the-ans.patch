From dfb0df0ad3e05c77ffecbd40d259910f3c4e3b46 Mon Sep 17 00:00:00 2001
From: Yves Bicker <yves_bicker@icloud.com>
Date: Mon, 19 Oct 2026 11:12:35 +0200
Subject: [PATCH 6/6] [MORALGYM] distill_after: let the teacher score the
 answer without the thinking

self_distillation.distill_after_hide_thinking (default false): the
teacher sequence is its prompt, distill_after_teacher_prefix (e.g.
"</think>\n" to close a prefilled <think>) and only the response tokens
after the marker. Teacher log-probs and top-k values are gathered back
to the student's positions, so the loss is unchanged otherwise. Without
this the teacher reads the student's full reasoning before the answer
and largely agrees with it, which left an Olmo-3-Think run flat.
---
 verl/trainer/config/actor/actor.yaml |  5 +++++
 verl/trainer/ppo/ray_trainer.py      | 32 ++++++++++++++++++++++++++++
 verl/workers/actor/dp_actor.py       | 22 +++++++++++++++----
 verl/workers/config/actor.py         |  4 ++++
 4 files changed, 59 insertions(+), 4 deletions(-)

diff --git a/verl/trainer/config/actor/actor.yaml b/verl/trainer/config/actor/actor.yaml
index ef00725..ced233f 100644
--- a/verl/trainer/config/actor/actor.yaml
+++ b/verl/trainer/config/actor/actor.yaml
@@ -120,6 +120,11 @@ self_distillation:
   # (e.g. "</think>"); responses without the marker contribute no loss
   distill_after: null
 
+  # With distill_after: the teacher scores the answer tokens right after its prompt, never
+  # seeing the student's thinking; the prefix closes a prefilled <think> (e.g. "</think>\n")
+  distill_after_hide_thinking: False
+  distill_after_teacher_prefix: ""
+
   # Whether to include environment feedback in reprompting for wrong attempts
   # If True and feedback exists: use reprompt_template_feedback_solution (with solution) or reprompt_template_feedback (without solution)
   include_environment_feedback: True
diff --git a/verl/trainer/ppo/ray_trainer.py b/verl/trainer/ppo/ray_trainer.py
index 7ead734..18437df 100644
--- a/verl/trainer/ppo/ray_trainer.py
+++ b/verl/trainer/ppo/ray_trainer.py
@@ -302,6 +302,27 @@ def _mask_after_marker(responses: torch.Tensor, response_mask: torch.Tensor, tok
     return out * response_mask
 
 
+def _answer_only_responses(responses: torch.Tensor, token_mask: torch.Tensor, prefix_ids: list, pad_token_id: int):
+    """Teacher-side response tensors holding only the masked-in tokens, left-aligned after
+    `prefix_ids`. Returns (teacher_responses, teacher_response_mask, gather_index), where
+    gather_index maps each student position to its teacher position (0 where unused).
+    """
+    bs, L = responses.shape
+    out = torch.full_like(responses, pad_token_id)
+    mask = torch.zeros_like(responses)
+    gather = torch.zeros_like(responses)
+    k = len(prefix_ids)
+    if k:
+        out[:, :k] = torch.tensor(prefix_ids, device=responses.device, dtype=responses.dtype)
+    for i in range(bs):
+        pos = token_mask[i].nonzero(as_tuple=True)[0][: L - k]
+        n = pos.numel()
+        out[i, k : k + n] = responses[i, pos]
+        gather[i, pos] = torch.arange(k, k + n, device=responses.device)
+        mask[i, : k + n] = 1
+    return out, mask, gather
+
+
 class RayPPOTrainer:
     """Distributed PPO trainer using Ray for scalable reinforcement learning.
 
@@ -802,6 +823,17 @@ class RayPPOTrainer:
         distill_after = self_distillation_cfg.get("distill_after", None)
         if distill_after:
             tensors["distill_token_mask"] = _mask_after_marker(responses, response_mask, self.tokenizer, distill_after)
+            if self_distillation_cfg.get("distill_after_hide_thinking", False):
+                prefix = self_distillation_cfg.get("distill_after_teacher_prefix", "") or ""
+                prefix_ids = self.tokenizer(prefix, add_special_tokens=False)["input_ids"] if prefix else []
+                teacher_responses, teacher_response_mask, gather_index = _answer_only_responses(
+                    responses, tensors["distill_token_mask"], prefix_ids, self.tokenizer.pad_token_id
+                )
+                teacher_input_ids = torch.cat([teacher_prompt["input_ids"].to(device), teacher_responses], dim=1)
+                teacher_attention_mask = torch.cat([teacher_prompt["attention_mask"].to(device), teacher_response_mask], dim=1)
+                teacher_position_ids = compute_position_id_with_mask(teacher_attention_mask)
+                tensors["teacher_responses"] = teacher_responses
+                tensors["teacher_gather_index"] = gather_index
 
         uids = set(batch.non_tensor_batch["uid"])
         num_with_feedback_available = sum(1 for f in feedback_list if f is not None)
