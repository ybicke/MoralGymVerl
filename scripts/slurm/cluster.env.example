# Cluster settings for the SLURM launchers and the training config.
# Copy to scripts/slurm/cluster.env (git-ignored) and adjust.
# Plain KEY=VALUE lines; $USER, $HOME and $SCRATCH are expanded.

# SLURM account charged for training and evaluation jobs.
SLURM_ACCOUNT=your_account

# Live checkpoints and rollouts. Must be a path mounted inside the container.
MORALGYM_CKPT_ROOT=$SCRATCH/moralgym_verl_runs

# Optional long-term store for checkpoints and eval cells. Leave empty to
# keep everything under MORALGYM_CKPT_ROOT and the local eval_results/.
MORALGYM_STORE_ROOT=

# Source checkouts, as seen inside the container.
MORALGYM_DIR=$HOME/MoralGymVerl
SDPO_DIR=$HOME/SDPO

# Hugging Face cache used by scripts/preflight/check_model_template.py.
HF_HOME=$HOME/.cache/huggingface
