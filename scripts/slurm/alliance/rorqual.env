# Rorqual (Alliance Canada, Calcul Québec) constants for the launchers in
# scripts/slurm/alliance/, which serve Fir and Rorqual. Plain KEY="VALUE" lines,
# read by fir_env.sh (bash) and fir_env.py (python); selected when
# CC_CLUSTER=rorqual (set by the Alliance on login and compute nodes).
# Differences from fir.env are marked "Rorqual:"; keep the rest in step.
#
# Node (sinfo, 2026-11-19): 4x H100 80 GB SXM5, 64 cores, 500 GB RAM
# (512000 MB). MIG nodes offer the same slices as Fir (3g.40gb, 2g.20gb,
# 1g.10gb). Partitions are chosen by the scheduler; no --partition.
# Accounts carry a suffix: rrg-zhijing_gpu, def-zhijing_gpu, def-zhijing_cpu
# (SLURM_ACCOUNT in scripts/slurm/cluster.env). Heterogeneous jobs are
# accepted (sbatch --test-only, Slurm 25.11).

FIR_VENV="${MORALGYM_VENV:-${HOME}/venvs/moralgym}"
FIR_HOST_PYTHON="${FIR_VENV}/bin/python"
FIR_MODULES="StdEnv/2023 python/3.11 arrow/25.0.0 apptainer/1.3.5"

# Same image as Fir, built from Apptainer.fir.def on this cluster.
FIR_SIF="${MORALGYM_SIF:-${SCRATCH}/containers/moralgym-verl-fir.sif}"

# Rorqual: 64 cores and 500 GB per node (Fir: 48 and ~1125 GB), so 16 cores
# and 120 GB per GPU.
FIR_NODE_GPUS="4"
FIR_NODE_CPUS="64"
FIR_NODE_MEM="480G"
FIR_MEM_PER_GPU_GB="120"
FIR_PACK_CPUS_PER_CELL="16"
FIR_SBATCH_NODE_ARGS="--gpus-per-node=h100:4"
FIR_SBATCH_GPU_ARGS="--gpus-per-node=h100:1 --cpus-per-task=16 --mem=120G"

# Container env, as on Fir.
HF_HUB_OFFLINE="1"
VLLM_CACHE_ROOT="/tmp/vllm_cache"
CUDA_CACHE_DISABLE="1"
TOKENIZERS_PARALLELISM="false"
VLLM_ATTENTION_BACKEND="FLASHINFER"
VLLM_NO_USAGE_STATS="1"
# Rorqual's nodes export the same AlmaLinux CA paths as Fir
# (/etc/pki/tls/certs/ca-bundle.crt), absent in the Ubuntu-based container.
APPTAINERENV_SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
APPTAINERENV_CURL_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
APPTAINERENV_REQUESTS_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
FIR_STAGE_MODEL="1"
