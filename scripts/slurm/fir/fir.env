# Fir (Alliance Canada, SFU) constants for the launchers in scripts/slurm/fir/.
# Plain KEY="VALUE" lines, read by fir_env.sh (bash) and fir_env.py (python).
# $HOME, $SCRATCH, $USER and keys from scripts/slurm/cluster.env expand.
#
# Node: 4x H100 80 GB SXM, 48 cores, ~1125 GB RAM, 7 TB NVMe at $SLURM_TMPDIR.
# One GPU = 12 cores + ~250 GB. Billing is per GPU; partitions are chosen by
# the scheduler from GPUs and walltime, so no --partition anywhere.

# Host-side python (outside the container): virtualenv built by
# scripts/setup/setup_fir.sh from the python/3.11 module. pyarrow is not
# pip-installable here (Alliance pythons reject manylinux wheels); it comes
# from the arrow module, which FIR_MODULES loads and which puts it on
# PYTHONPATH — so host-side python calls must append to PYTHONPATH, never
# replace it.
FIR_VENV="${MORALGYM_VENV:-${HOME}/venvs/moralgym}"
FIR_HOST_PYTHON="${FIR_VENV}/bin/python"
FIR_MODULES="StdEnv/2023 python/3.11 arrow/25.0.0 apptainer/1.3.5"

# Container image (scripts/setup/setup_fir.sh builds it from Apptainer.fir.def).
FIR_SIF="${MORALGYM_SIF:-${SCRATCH}/containers/moralgym-verl-fir.sif}"

# Whole-node job (training, packed evals) and single-GPU job (one eval cell).
FIR_NODE_GPUS="4"
FIR_NODE_CPUS="48"
FIR_NODE_MEM="1000G"
FIR_PACK_CPUS_PER_CELL="12"
FIR_SBATCH_NODE_ARGS="--gpus-per-node=h100:4"
FIR_SBATCH_GPU_ARGS="--gpus-per-node=h100:1 --cpus-per-task=12 --mem=120G"

# Container env (what ~/.edf/moralgym_verl.toml [env] sets on Clariden;
# Apptainer inherits the job environment, so exporting is enough).
# HF_HOME is taken from cluster.env (keep it on $SCRATCH: weights are 16+ GB).
# Compute nodes have internet, but runs stay offline so a job never
# re-downloads or silently picks a newer revision; HF_HUB_OFFLINE=0 for a one-off.
HF_HUB_OFFLINE="1"
# vLLM compile cache under /tmp = $SLURM_TMPDIR, discarded with the job.
VLLM_CACHE_ROOT="/tmp/vllm_cache"
# No CUDA JIT caches on Lustre (many small files).
CUDA_CACHE_DISABLE="1"
TOKENIZERS_PARALLELISM="false"
# Gemma-2 tanh softcapping requires the FlashInfer attention backend.
VLLM_ATTENTION_BACKEND="FLASHINFER"
# vLLM phones home from a worker thread; pointless here and it tracebacks
# into the log when TLS is misconfigured (seen in smoke job 66075174).
VLLM_NO_USAGE_STATS="1"
# Fir's login/compute nodes export SSL_CERT_FILE and CURL_CA_BUNDLE pointing
# at the AlmaLinux bundle (/etc/pki/tls/certs/ca-bundle.crt), which does not
# exist in the Ubuntu-based container, so every HTTPS call inside it (W&B,
# HF when online) fails. APPTAINERENV_* sets a variable inside the container
# only; the host keeps its own.
APPTAINERENV_SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
APPTAINERENV_CURL_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
APPTAINERENV_REQUESTS_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
# Stage the model's HF snapshot to node-local NVMe at job start (train_job.sh):
# smoke job 66075174 spent 11 min loading 16 GB from Lustre with 4 readers.
# 0 disables it (the container then reads HF_HOME on $SCRATCH directly).
FIR_STAGE_MODEL="1"
